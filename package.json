{
  "name": "@gamely/gly-ide",
  "description": "IDE da Gly Engine",
  "homepage": "https://ide.gamely.com.br",
  "repository": "https://github.com/gamelly/gly-ide",
  "bugs": "https://github.com/gamelly/gly-ide/issues",
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=20.14.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier . --write --config .prettierrc",
    "check": "prettier . --check --config .prettierrc",
    "type-check": "tsc --noEmit",
    "dev": "npm run build:engine && vite",
    "build": "npm run build:engine && tsc -b && vite build",
    "build:engine": "./scripts/build_engine.sh",
    "preview": "npm run build:engine && vite preview"
  },
  "dependencies": {
    "@babel/plugin-transform-react-jsx": "^7.25.9",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^6.4.5",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@tailwindcss/vite": "^4.0.7",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.4.3",
    "@zenfs/core": "^1.11.2",
    "@zenfs/dom": "^1.1.5",
    "animate.css": "^4.1.1",
    "lz-string": "^1.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-feather": "^2.0.10",
    "react-hot-toast": "^2.5.2",
    "react-router-dom": "^7.2.0",
    "tailwindcss": "^4.0.7",
    "uuid": "^11.1.0",
    "wasmoon": "1.16.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "prettier": "^3.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.1.0",
    "vite-plugin-top-level-await": "^1.5.0",
