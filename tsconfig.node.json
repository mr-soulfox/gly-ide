{
	"compilerOptions": {
		"composite": true,
		"skipLibCheck": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowSyntheticDefaultImports": true,
		"jsx": "preserve",

		/* Alias */
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*", "./dist/*", ""],
			"~/*": ["public/*"]
		}
	},
	"include": ["vite.config.ts"]
}
